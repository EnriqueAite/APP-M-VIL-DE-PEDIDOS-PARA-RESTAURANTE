<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/saludo_titulo"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/brown_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/saludo_subtitulo"
                android:textSize="14sp"
                android:textColor="@color/text_hint"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/ivLogout"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_user_profile"
            android:contentDescription="Cerrar sesión"/>
    </RelativeLayout>

    <!-- Buscador -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_input_field"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:hint="@string/hint_buscar"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp"
        android:inputType="text"
        android:autofillHints="off"/>

    <!-- Filtros de categoría -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnTodos"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@string/filtro_todos"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:background="@drawable/bg_button_primary"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/btnCarnes"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@string/filtro_carnes"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/brown_primary"
                android:textSize="13sp"
                android:background="@drawable/bg_filter_inactive"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/btnPescados"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@string/filtro_pescados"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/brown_primary"
                android:textSize="13sp"
                android:background="@drawable/bg_filter_inactive"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/btnEnsaladas"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Ensaladas"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/brown_primary"
                android:textSize="13sp"
                android:background="@drawable/bg_filter_inactive"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/btnBebidas"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Bebidas"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/brown_primary"
                android:textSize="13sp"
                android:background="@drawable/bg_filter_inactive"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Lista de platos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlatos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"/>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:background="@color/white"
        android:elevation="8dp">

        <!-- Menú -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍽"
                android:textSize="18sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_menu"
                android:textSize="11sp"
                android:textColor="@color/brown_primary"/>
        </LinearLayout>

        <!-- Carrito — con id para navegación -->
        <LinearLayout
            android:id="@+id/navCarrito"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛒"
                android:textSize="18sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_carrito"
                android:textSize="11sp"
                android:textColor="@color/text_hint"/>
        </LinearLayout>

        <!-- Pedidos -->
        <LinearLayout
            android:id="@+id/navPedidos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋"
                android:textSize="18sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_pedidos"
                android:textSize="11sp"
                android:textColor="@color/text_hint"/>
        </LinearLayout>

        <!-- Perfil -->
        <LinearLayout
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="18sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_perfil"
                android:textSize="11sp"
                android:textColor="@color/text_hint"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>