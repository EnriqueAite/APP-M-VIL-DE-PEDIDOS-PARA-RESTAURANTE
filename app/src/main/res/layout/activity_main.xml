<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="60dp"
        android:paddingBottom="40dp">

        <!-- Logo circular -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="20dp">

            <View
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/bg_circle_brown"/>

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:contentDescription="Logo El Buen Sabor"
                android:src="@drawable/ic_logo_plate" />
        </FrameLayout>

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/brown_primary"
            android:layout_marginBottom="6dp"/>

        <!-- Subtítulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_subtitle"
            android:textSize="14sp"
            android:textColor="@color/text_hint"
            android:layout_marginBottom="40dp"/>

        <!-- Label Correo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_email"
            android:textSize="13sp"
            android:textColor="@color/text_hint"
            android:layout_marginBottom="6dp"/>

        <!-- Campo Correo -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textEmailAddress"
            android:hint="cliente@elbuensabor.com"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:layout_marginBottom="20dp"/>

        <!-- Label Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_password"
            android:textSize="13sp"
            android:textColor="@color/text_hint"
            android:layout_marginBottom="6dp"/>

        <!-- Campo Contraseña -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textPassword"
            android:hint="••••••••"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:layout_marginBottom="28dp"/>

        <!-- Botón Iniciar Sesión -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_login"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:layout_marginBottom="14dp"/>

        <!-- Botón Registrarse -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_register"
            android:textColor="@color/brown_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_outline"
            android:layout_marginBottom="24dp"/>

        <!-- Mensaje de rol -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/msg_role"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>