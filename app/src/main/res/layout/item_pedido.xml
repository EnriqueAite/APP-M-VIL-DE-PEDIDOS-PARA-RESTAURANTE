<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_plato"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="10dp"
    android:padding="14dp">

    <!-- Encabezado: código + ícono + estado + flecha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivEstadoIcono"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Estado"/>

        <TextView
            android:id="@+id/tvCodigoPedido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/brown_primary"/>

        <TextView
            android:id="@+id/tvEstadoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/btnExpandir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▼"
            android:textSize="14sp"
            android:textColor="@color/text_hint"/>

    </LinearLayout>

    <!-- Resumen corto (siempre visible) -->
    <TextView
        android:id="@+id/tvResumenProductos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/text_hint"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tvTotalCorto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/brown_primary"
        android:gravity="end"
        android:layout_marginTop="8dp"/>

    <!-- Sección expandible -->
    <LinearLayout
        android:id="@+id/layoutExpandido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="12dp">

        <!-- Barra de progreso de estados -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <View android:id="@+id/dotPendiente"
                android:layout_width="14dp" android:layout_height="14dp"
                android:background="@drawable/bg_circle_brown"/>
            <View android:layout_width="0dp" android:layout_height="2dp"
                android:layout_weight="1" android:background="#DDDDDD"/>
            <View android:id="@+id/dotPreparando"
                android:layout_width="14dp" android:layout_height="14dp"
                android:background="@drawable/bg_circle_gris"/>
            <View android:layout_width="0dp" android:layout_height="2dp"
                android:layout_weight="1" android:background="#DDDDDD"/>
            <View android:id="@+id/dotEnviado"
                android:layout_width="14dp" android:layout_height="14dp"
                android:background="@drawable/bg_circle_gris"/>
            <View android:layout_width="0dp" android:layout_height="2dp"
                android:layout_weight="1" android:background="#DDDDDD"/>
            <View android:id="@+id/dotEntregado"
                android:layout_width="14dp" android:layout_height="14dp"
                android:background="@drawable/bg_circle_gris"/>
        </LinearLayout>

        <!-- Etiquetas de estados -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Pendiente"
                android:textSize="10sp" android:gravity="center" android:textColor="@color/brown_primary"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Preparando"
                android:textSize="10sp" android:gravity="center" android:textColor="@color/text_hint"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Enviado"
                android:textSize="10sp" android:gravity="center" android:textColor="@color/text_hint"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Entregado"
                android:textSize="10sp" android:gravity="center" android:textColor="@color/text_hint"/>
        </LinearLayout>

        <!-- Mensaje según estado -->
        <TextView
            android:id="@+id/tvMensajeEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_dark"
            android:background="#FFF3E0"
            android:padding="10dp"
            android:layout_marginBottom="12dp"/>

        <!-- Dirección -->
        <TextView
            android:id="@+id/tvDireccionPedido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="8dp"/>

        <!-- Título productos -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Productos:"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="4dp"/>

        <!-- Lista de productos del pedido -->
        <LinearLayout
            android:id="@+id/layoutProductosPedido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </LinearLayout>

</LinearLayout>